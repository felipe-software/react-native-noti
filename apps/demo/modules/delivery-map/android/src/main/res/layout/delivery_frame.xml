<?xml version="1.0" encoding="utf-8"?>
<!-- One animation step. Every view is centered, and each frame only sets its transforms. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/delivery_map_under"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/delivery_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
    <ImageView
        android:id="@+id/delivery_ring"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/delivery_ring" />
    <ImageView
        android:id="@+id/delivery_home"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:background="@drawable/delivery_marker_base"
        android:elevation="3dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/delivery_marker_home" />
    <ImageView
        android:id="@+id/delivery_courier"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:background="@drawable/delivery_marker_base"
        android:elevation="3dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/delivery_marker_courier" />
</FrameLayout>
