<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <application>
    <service
      android:name="expo.modules.notificationmotion.DoomService"
      android:exported="false"
      android:foregroundServiceType="specialUse"
      android:stopWithTask="false">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="User-started interactive Doom game rendered and controlled in an ongoing notification" />
    </service>
    <receiver android:name=".MotionActionReceiver" android:exported="false" />
    <provider
      android:name="expo.modules.notificationmotion.FrameAssetProvider"
      android:authorities="${applicationId}.notificationmotion.frames"
      android:exported="false"
      android:grantUriPermissions="true" />
    <!-- Live Doom frames. SystemUI reads them with its own permission because the per-update
         grants NotificationManager issues are revoked while late inflations still read. -->
    <provider
      android:name="expo.modules.notificationmotion.DoomFrameProvider"
      android:authorities="${applicationId}.notificationmotion.doom"
      android:exported="true"
      android:permission="android.permission.STATUS_BAR_SERVICE"
      android:grantUriPermissions="true" />
    <provider
      android:name="expo.modules.notificationmotion.DoomLiveFrameProvider"
      android:authorities="${applicationId}.notificationmotion.doom.live"
      android:exported="true"
      android:permission="android.permission.STATUS_BAR_SERVICE"
      android:grantUriPermissions="true" />
    <service
      android:name="expo.modules.notificationmotion.FramePlaybackService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback"
      android:stopWithTask="false" />
  </application>
</manifest>
