<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <application>
    <receiver android:name=".MotionActionReceiver" android:exported="false" />
    <provider
      android:name="expo.modules.notificationmotion.FrameAssetProvider"
      android:authorities="${applicationId}.notificationmotion.frames"
      android:exported="false"
      android:grantUriPermissions="true" />
    <service
      android:name="expo.modules.notificationmotion.FramePlaybackService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback"
      android:stopWithTask="false" />
  </application>
</manifest>
