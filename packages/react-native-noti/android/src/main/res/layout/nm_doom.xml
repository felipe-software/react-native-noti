<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#111111">
    <!-- Controls have their own stable notification; video updates replace only this row. -->
    <ViewFlipper android:id="@+id/nm_doom_frame"
        android:layout_width="match_parent" android:layout_height="184dp"
        android:autoStart="true" android:animateFirstView="false"
        android:measureAllChildren="false" android:contentDescription="Live Doom gameplay" />
    <TextView android:id="@+id/nm_doom_status" android:layout_width="match_parent"
        android:layout_height="20dp" android:visibility="gone" android:gravity="center" android:textColor="#AAAAAA"
        android:textSize="10sp" android:maxLines="1" />
</LinearLayout>
