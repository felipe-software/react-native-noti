<?xml version="1.0" encoding="utf-8"?>
<!-- Runs in the RemoteViews host; no app-process touch listener is required. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:duration="60"
                android:valueTo="0.95" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:duration="60"
                android:valueTo="0.95" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:duration="60"
                android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:duration="60"
                android:valueTo="1.0" android:valueType="floatType" />
        </set>
    </item>
</selector>
